{
  "mcp": {
    "servers": {
      "pages": {
        "command": "node",
        "args": ["/path/to/pages-mcp-vX.Y.Z.js"],
        "env": {
          "PAGES_URL": "https://pages.example.com",
          "PAGES_TOKEN": "${PAGES_TOKEN}"
        }
      },
      "pages-http": {
        "url": "https://mcp.example.com/mcp",
        "transport": "streamable-http",
        "auth": "oauth"
      }
    }
  }
}
