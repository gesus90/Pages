{
  "name": "pages-mcp",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "check": "tsc --noEmit && prettier --check .",
    "build": "node build.config.ts",
    "test:mcp": "pnpm run build && node tests/stdio/client.ts",
    "test": "vitest run --coverage --maxWorkers=1",
    "clean": "node -e \"for (const artifact of ['node_modules', 'dist', 'coverage']) require('node:fs').rmSync(artifact, { recursive: true, force: true })\""
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.2.0"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "@vitest/coverage-v8": "5.0.3",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "eslint-plugin-jsdoc": "64.5.4",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@11.23.0"
}
