@@ -0,0 +1,129 @@
+import { tool, jsonSchema, type Tool } from "ai"
+import type { JSONSchema7 } from "@ai-sdk/provider"
+import { PartID } from "@/session/schema"
+
+type Request = (method: string, params: Record<string, unknown>) => Promise<Record<string, unknown>>
+type Entry = { name: string; description: string; inputSchema: JSONSchema7 }
+type Thread = { turn: string | null; calls: Set<string> }
+const active = process.env.PAGES_PICA_OPENCODE === "1"
+let request: Request | undefined
+let catalog: Entry[] | undefined
+const threads = new Map<string, Thread>()
+let tail: Promise<void> = Promise.resolve()
+let queued = 0
+const record = (value: unknown): value is Record<string, unknown> => value !== null && typeof value === "object" && !Array.isArray(value)
+const identity = (value: string) => /^[A-Za-z0-9._:-]{1,256}$/.test(value)
+const refuse = (): never => { throw new Error("Pica operation refused") }
+
+async function rpc(method: string, params: Record<string, unknown>) {
+  if (!request) return refuse()
+  try { return await request("_pages/pica/" + method, params) } catch { return refuse() }
+}
+async function images(call: {threadId: string; turnId: string; callId: string}, receipt: string, metadata: unknown[]) {
+  const output: {type: "file"; mime: string; url: string; id: ReturnType<typeof PartID.ascending>; sessionID: string; messageID: string}[] = []
+  for (let i = 0; i < metadata.length; i++) {
+    const item = metadata[i]
+    if (!record(item) || Object.keys(item).some((key) => !["mimeType", "length"].includes(key)) ||
+      (item.mimeType !== "image/png" && item.mimeType !== "image/jpeg") || typeof item.length !== "number" ||
+      !Number.isSafeInteger(item.length) || item.length < 4 || item.length > 8_000_000 || item.length % 4 !== 0) return refuse()
+    let data = ""
+    while (data.length < item.length) {
+      const chunk = await rpc("chunk", { ...call, receipt, image: i, offset: data.length })
+      if (Object.keys(chunk).some((key) => !["data", "next"].includes(key)) || typeof chunk.data !== "string" ||
+        chunk.data.length < 1 || chunk.data.length > 524288 || chunk.next !== data.length + chunk.data.length || chunk.next > item.length) return refuse()
+      data += chunk.data
+    }
+    if (!/^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$/.test(data)) return refuse()
+    const bytes = Buffer.from(data, "base64")
+    const png = bytes.length >= 8 && bytes.subarray(0, 8).equals(Buffer.from([137, 80, 78, 71, 13, 10, 26, 10]))
+    const jpeg = bytes.length >= 3 && bytes[0] === 255 && bytes[1] === 216 && bytes[2] === 255
+    if ((item.mimeType === "image/png" && !png) || (item.mimeType === "image/jpeg" && !jpeg)) return refuse()
+    output.push({ type: "file", mime: item.mimeType, url: "data:" + item.mimeType + ";base64," + data,
+      id: PartID.ascending(), sessionID: call.threadId, messageID: call.turnId })
+  }
+  return output
+}
+async function invoke(threadId: string, turnId: string, callId: string, name: string, args: unknown, signal?: AbortSignal) {
+  const thread = threads.get(threadId)
+  if (!thread || thread.turn !== turnId || !identity(callId) || thread.calls.has(callId) || !record(args) ||
+    Buffer.byteLength(JSON.stringify(args), "utf8") > 1048576 || !catalog?.some((entry) => entry.name === name) || signal?.aborted) return refuse()
+  if (thread.calls.size >= 4096 || queued >= 32) return refuse()
+  thread.calls.add(callId)
+  const deadline = Date.now() + 30_000
+  queued++
+  const task = tail.then(async () => {
+    if (Date.now() > deadline || threads.get(threadId) !== thread || thread.turn !== turnId || signal?.aborted) return refuse()
+    const call = { threadId, turnId, callId }
+    const result = await rpc("dispatch", { ...call, tool: name, arguments: args })
+    if (threads.get(threadId) !== thread || thread.turn !== turnId || signal?.aborted ||
+      Object.keys(result).some((key) => !["success", "text", "receipt", "images"].includes(key)) ||
+      typeof result.success !== "boolean" || typeof result.text !== "string" || Buffer.byteLength(result.text) > 1048576 ||
+      !Array.isArray(result.images) || result.images.length > 4) return refuse()
+    if ((result.images.length === 0 && result.receipt !== null) ||
+      (result.images.length > 0 && (typeof result.receipt !== "string" || !/^[0-9a-f-]{36}$/.test(result.receipt)))) return refuse()
+    const attachments = result.images.length ? await images(call, String(result.receipt), result.images) : []
+    if (threads.get(threadId) !== thread || thread.turn !== turnId || signal?.aborted) return refuse()
+    return { title: name, output: result.text, metadata: {}, attachments }
+  })
+  tail = task.then(() => undefined, () => undefined)
+  try { return await task } finally { queued-- }
+}
+
+/** Pica-only native runtime; Pages owns its ACP connection and human-turn binding. */
+export const PagesPica = {
+  active,
+  attach(connection: {extMethod(method: string, params: Record<string, unknown>): Promise<Record<string, unknown>>} | undefined) {
+    if (!connection || request) return refuse()
+    request = connection.extMethod.bind(connection)
+  },
+  async load() {
+    if (!active || catalog) return refuse()
+    const result = await rpc("catalog", {})
+    if (!Array.isArray(result.tools) || result.tools.length < 1 || result.tools.length > 512 || Buffer.byteLength(JSON.stringify(result)) > 1048576) return refuse()
+    const names = new Set<string>()
+    const entries: Entry[] = []
+    for (const item of result.tools) {
+      if (!record(item) || Object.keys(item).some((key) => !["name", "description", "inputSchema"].includes(key)) ||
+        typeof item.name !== "string" || !/^[A-Za-z0-9_-]{1,100}$/.test(item.name) || names.has(item.name) ||
+        typeof item.description !== "string" || item.description.length < 1 || item.description.length > 10000 ||
+        !record(item.inputSchema) || item.inputSchema.type !== "object") return refuse()
+      names.add(item.name)
+      entries.push({ name: item.name, description: item.description, inputSchema: item.inputSchema as JSONSchema7 })
+    }
+    catalog = entries
+  },
+  async bindThread(threadId: string) {
+    if (!catalog || !identity(threadId) || threads.has(threadId)) return refuse()
+    if ((await rpc("bind_thread", { threadId })).accepted !== true) return refuse()
+    threads.set(threadId, { turn: null, calls: new Set() })
+  },
+  async tools(threadId: string, messageId: string): Promise<Record<string, Tool>> {
+    const thread = threads.get(threadId)
+    if (!thread || !catalog || !identity(messageId)) return refuse()
+    if (thread.turn !== messageId) {
+      if (thread.turn) await rpc("end_turn", { threadId, turnId: thread.turn })
+      thread.turn = null
+      if ((await rpc("bind_turn", { threadId, turnId: messageId })).accepted !== true) return refuse()
+      thread.turn = messageId
+    }
+    return Object.fromEntries(catalog.map((entry) => [entry.name, tool({
+      description: entry.description,
+      inputSchema: jsonSchema(entry.inputSchema),
+      execute: (args, options) => invoke(threadId, messageId, options.toolCallId, entry.name, args, options.abortSignal),
+    })]))
+  },
+  async end(threadId: string) {
+    const thread = threads.get(threadId)
+    if (!thread) return refuse()
+    if (!thread.turn) return
+    const turnId = thread.turn
+    thread.turn = null
+    await rpc("end_turn", { threadId, turnId })
+  },
+  async close(threadId: string) {
+    await this.end(threadId)
+    if (!threads.has(threadId)) return refuse()
+    threads.delete(threadId)
+    await rpc("close_thread", { threadId })
+  },
+}
