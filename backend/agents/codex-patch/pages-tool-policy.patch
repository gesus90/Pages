+/// Shared, one-way owner-loss signal; callbacks must not block or await.
+#[derive(Default)]
+pub struct PicaOwnerLiveness {
+    state: std::sync::Mutex<(bool, Vec<Box<dyn FnOnce() + Send>>)>,
+}
+
+impl std::fmt::Debug for PicaOwnerLiveness {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result { f.write_str("PicaOwnerLiveness") }
+}
+
+impl PicaOwnerLiveness {
+    pub fn register(&self, callback: Box<dyn FnOnce() + Send>) {
+        let Ok(mut state) = self.state.lock() else { callback(); return; };
+        if state.0 { drop(state); callback(); } else { state.1.push(callback); }
+    }
+    pub fn revoke(&self) {
+        let mut state = self.state.lock().unwrap_or_else(std::sync::PoisonError::into_inner);
+        state.0 = true;
+        let callbacks = std::mem::take(&mut state.1);
+        drop(state);
+        for callback in callbacks { callback(); }
+    }
+    pub fn live(&self) -> bool { self.state.lock().is_ok_and(|state| !state.0) }
+}
