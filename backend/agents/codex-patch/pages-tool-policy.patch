+impl serde::Serialize for JsonSchema {
+    fn serialize<S>(&self, serializer: S) -> Result<S::Ok, S::Error>
+    where
+        S: serde::Serializer,
+    {
+        if let Some(raw) = &self.pica_raw_schema {
+            return raw.serialize(serializer);
+        }
+        use serde::ser::SerializeMap;
+        let mut map = serializer.serialize_map(None)?;
+        macro_rules! field {
+            ($key:literal, $value:expr) => {
+                if let Some(value) = $value { map.serialize_entry($key, value)?; }
+            };
+        }
+        field!("$ref", &self.schema_ref);
+        field!("type", &self.schema_type);
+        field!("description", &self.description);
+        field!("encrypted", &self.encrypted);
+        field!("enum", &self.enum_values);
+        field!("items", &self.items);
+        field!("minItems", &self.min_items);
+        field!("properties", &self.properties);
+        field!("required", &self.required);
+        field!("additionalProperties", &self.additional_properties);
+        field!("anyOf", &self.any_of);
+        field!("oneOf", &self.one_of);
+        field!("allOf", &self.all_of);
+        field!("$defs", &self.defs);
+        field!("definitions", &self.definitions);
+        map.end()
+    }
+}
