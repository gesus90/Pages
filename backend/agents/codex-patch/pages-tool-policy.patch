+    let turn_id = turn.sub_id.clone();
+    let owner = Arc::clone(&policy.owner);
+    let result = Arc::clone(&settlement);
+    let on_loss = Arc::downgrade(&settlement);
+    owner.register(Box::new(move || {
+        if let Some(settlement) = on_loss.upgrade() {
+            settlement.finish(codex_protocol::protocol::PicaRevocationOutcome::Unavailable);
+        }
+    }));
+    tokio::spawn(async move {
+        use codex_protocol::protocol::PicaRevocationOutcome;
+        let receiver = settlement.subscribe();
+        if !owner.live() || !matches!(tokio::time::timeout(std::time::Duration::from_secs(5), tx.send(codex_protocol::protocol::Event {
+            id: turn_id, msg: EventMsg::PicaRegistryRevoked(request),
+        })).await, Ok(Ok(()))) {
+            settlement.finish(PicaRevocationOutcome::Unavailable);
+        }
+        let outcome = match tokio::time::timeout(std::time::Duration::from_secs(26), receiver).await {
+            Ok(Ok(outcome)) => outcome,
+            _ => { settlement.finish(PicaRevocationOutcome::Unavailable); PicaRevocationOutcome::Unavailable }
+        };
+        if outcome != PicaRevocationOutcome::Acknowledged { owner.revoke(); }
+    });
+    Some(result)
 }
 
