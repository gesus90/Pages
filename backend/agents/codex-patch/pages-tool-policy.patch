new file mode 100644
index 0000000..fe2d41c
--- /dev/null
+++ b/codex-rs/core/src/session/pica_dynamic_events.rs
@@ -0,0 +1,496 @@
+//! Retained event settlement for admitted Pica dynamic calls.
+//!
+//! This registry is not attached to a turn until its callers explicitly wire it.
+
+use std::collections::{HashMap, HashSet};
+use std::sync::{Arc, Mutex, Weak};
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::time::Duration;
+
+use codex_protocol::dynamic_tools::DynamicToolResponse;
+use futures::FutureExt;
+use codex_protocol::items::{DynamicToolCallStatus, TurnItem};
+use codex_protocol::protocol::{Event, EventMsg};
+use tokio::sync::{oneshot, watch};
+use tokio::task::JoinHandle;
+use tokio::time::{timeout, timeout_at, Instant};
+
+use super::session::Session;
+use super::turn_context::TurnContext;
+use crate::turn_timing::now_unix_timestamp_ms;
+
+const MAX_ACTIVE: usize = 64;
+const MAX_GENERATIONS: usize = 4096;
+const MAX_START_BYTES: usize = 1024 * 1024;
+const MAX_RESPONSE_BYTES: usize = 32 * 1024 * 1024;
+const WAIT_LIMIT: Duration = Duration::from_secs(30);
+const PERSIST_LIMIT: Duration = Duration::from_secs(10);
+const JOIN_LIMIT: Duration = Duration::from_secs(55);
+
+#[derive(Clone, Hash, PartialEq, Eq)]
+struct CallKey { turn: String, call: String, generation: u64 }
+
+/// Terminal result for a caller and the turn teardown owner.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum PicaEventSettlement {
+    NotAdmitted,
+    Completed,
+    Failed,
+    Cancelled,
+    Unavailable,
+    JoinUnobserved,
+}
+
+/// Terminal outcome for the exact turn, call and registry generation.
+#[derive(Clone)]
+pub(crate) struct PicaEventResult {
+    pub(crate) turn: String,
+    pub(crate) call: String,
+    pub(crate) generation: u64,
+    pub(crate) outcome: PicaEventSettlement,
+    pub(crate) stages: PicaEventStages,
+}
+
+/// Local observations only; no callback or storage durability is implied.
+#[derive(Clone, Copy, Debug, Default)]
+pub(crate) struct PicaEventStages {
+    pub(crate) start_effects_started: bool,
+    pub(crate) start_effects_finished: bool,
+    pub(crate) start_persisted: Option<bool>,
+    pub(crate) completion_preparation_started: bool,
+    pub(crate) completion_preparation_finished: bool,
+    pub(crate) terminal_enqueue_attempted: bool,
+    pub(crate) terminal_enqueue_succeeded: bool,
+    pub(crate) terminal_effects_started: bool,
+    pub(crate) terminal_effects_finished: bool,
+    pub(crate) terminal_persisted: Option<bool>,
+    pub(crate) fallback_outcome: Option<PicaEventSettlement>,
+}
+
+#[derive(Clone)]
+enum Terminal { Response(DynamicToolResponse), Cancelled }
+
+struct Control {
+    admission: Option<oneshot::Sender<Option<(Event, Instant)>>>,
+    terminal: Option<oneshot::Sender<Terminal>>,
+    admitted: bool,
+    closed: bool,
+    admitted_start: Option<(Event, Instant)>,
+    disposition: Option<Terminal>,
+    terminal_claimed: bool,
+    start_effects_started: bool,
+    start_effects_finished: bool,
+    start_persisted: Option<bool>,
+    completion_preparation_started: bool,
+    completion_preparation_finished: bool,
+    terminal_enqueue_attempted: bool,
+    terminal_enqueue_succeeded: bool,
+    terminal_effects_started: bool,
+    terminal_effects_finished: bool,
+    terminal_persisted: Option<bool>,
+    fallback_outcome: Option<PicaEventSettlement>,
+}
+
+struct Entry {
+    control: Arc<Mutex<Control>>,
+    worker: JoinHandle<PicaEventSettlement>,
+}
+
+/// Per-turn owner of bounded dynamic event workers and their join results.
+pub(crate) struct PicaDynamicEventRegistry {
+    session: Weak<Session>,
+    turn: Weak<TurnContext>,
+    active: HashMap<CallKey, Entry>,
+    records: HashMap<CallKey, Arc<Mutex<Control>>>,
+    used: HashSet<CallKey>,
+    results: Vec<PicaEventResult>,
+    closed: bool,
+}
+
+/// Result of the synchronous visible-event handoff.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum PicaEventAdmission {
+    NotAdmitted,
+    Committed,
+    CommittedUnavailable,
+}
+
+/// Request-side handle; dropping it signals cancellation without owning the worker.
+pub(crate) struct PicaDynamicEventTicket {
+    key: CallKey,
+    event: Event,
+    control: Arc<Mutex<Control>>,
+}
+
+impl PicaDynamicEventRegistry {
+    pub(crate) fn new(session: &Arc<Session>, turn: &Arc<TurnContext>) -> Self {
+        Self { session: Arc::downgrade(session), turn: Arc::downgrade(turn), active: HashMap::new(), records: HashMap::new(), used: HashSet::new(), results: Vec::new(), closed: false }
+    }
+
+    /// Reserve before lease admission; no visible or persisted event is produced here.
+    pub(crate) fn reserve(&mut self, turn: &TurnContext, event: Event, generation: u64) -> Option<PicaDynamicEventTicket> {
+        self.reap_finished();
+        let bound_turn = self.turn.upgrade()?;
+        let session = self.session.upgrade()?;
+        if !super::turn::pica_same_turn(bound_turn.as_ref(), turn) { return None; }
+        let EventMsg::ItemStarted(start) = &event.msg else { return None; };
+        let TurnItem::DynamicToolCall(item) = &start.item else { return None; };
+        if event.id != bound_turn.sub_id || start.turn_id != bound_turn.sub_id || start.thread_id != session.thread_id || generation == 0
+            || item.status != DynamicToolCallStatus::InProgress || item.success.is_some() || item.content_items.is_some() || item.error.is_some()
+            || serde_json::to_vec(&event).map_or(true, |bytes| bytes.len() > MAX_START_BYTES) { return None; }
+        let key = CallKey { turn: start.turn_id.clone(), call: item.id.clone(), generation };
+        let unresolved = self.records.values().filter(|control| {
+            control.lock().unwrap_or_else(|error| error.into_inner()).admitted_start.is_some()
+        }).count();
+        if self.closed || self.active.len() >= MAX_ACTIVE || unresolved >= MAX_ACTIVE || self.used.len() >= MAX_GENERATIONS || self.used.contains(&key)
+            || self.active.keys().any(|active| active.turn == key.turn && active.call == key.call) { return None; }
+        let (admission_tx, admission_rx) = oneshot::channel();
+        let (terminal_tx, terminal_rx) = oneshot::channel();
+        let control = Arc::new(Mutex::new(Control { admission: Some(admission_tx), terminal: Some(terminal_tx), admitted: false, closed: false,
+            admitted_start: None, disposition: None, terminal_claimed: false, start_effects_started: false, start_effects_finished: false, start_persisted: None,
+            completion_preparation_started: false, completion_preparation_finished: false, terminal_enqueue_attempted: false,
+            terminal_enqueue_succeeded: false, terminal_effects_started: false, terminal_effects_finished: false, terminal_persisted: None, fallback_outcome: None }));
+        let worker = tokio::spawn(run_worker(self.session.clone(), self.turn.clone(), control.clone(), admission_rx, terminal_rx));
+        self.used.insert(key.clone());
+        self.records.insert(key.clone(), control.clone());
+        self.active.insert(key.clone(), Entry { control: control.clone(), worker });
+        Some(PicaDynamicEventTicket { key, event, control })
+    }
+
+    /// Stop new reservations and wake every unadmitted or unsettled worker.
+    pub(crate) fn close(&mut self) {
+        self.closed = true;
+        for entry in self.active.values() { cancel(&entry.control); }
+    }
+
+    fn record(&mut self, key: CallKey, outcome: PicaEventSettlement) {
+        let stages = self.records.get(&key).map(|control| stages(control)).unwrap_or_default();
+        self.results.push(PicaEventResult { turn: key.turn, call: key.call, generation: key.generation, outcome, stages });
+    }
+
+    fn reap_finished(&mut self) {
+        let finished: Vec<_> = self.active.iter().filter_map(|(key, entry)| entry.worker.is_finished().then_some(key.clone())).collect();
+        for key in finished {
+            let result = self.active.get_mut(&key).and_then(|entry| (&mut entry.worker).now_or_never());
+            if let Some(result) = result {
+                self.active.remove(&key);
+                self.record(key, result.unwrap_or(PicaEventSettlement::Unavailable));
+            }
+        }
+    }
+
+    /// Use one deadline for the entire drain and retain handles that have not resolved.
+    pub(crate) async fn close_and_join(&mut self) -> Vec<PicaEventResult> {
+        self.close();
+        let deadline = Instant::now() + JOIN_LIMIT;
+        while let Some(key) = self.active.keys().next().cloned() {
+            let result = match self.active.get_mut(&key) {
+                Some(entry) => timeout_at(deadline, &mut entry.worker).await.ok(),
+                None => continue,
+            };
+            match result {
+                Some(result) => {
+                    self.active.remove(&key);
+                    self.record(key, result.unwrap_or(PicaEventSettlement::Unavailable));
+                }
+                None => break,
+            }
+        }
+        for entry in self.active.values_mut() { entry.worker.abort(); }
+        let abort_deadline = Instant::now() + Duration::from_secs(2);
+        let keys: Vec<_> = self.active.keys().cloned().collect();
+        for key in keys {
+            let result = match self.active.get_mut(&key) {
+                Some(entry) => timeout_at(abort_deadline, &mut entry.worker).await.ok(),
+                None => continue,
+            };
+            if let Some(joined) = result {
+                self.active.remove(&key);
+                self.record(key, joined.unwrap_or(PicaEventSettlement::Unavailable));
+            }
+        }
+        // A retained record can claim a cancellation terminal if its worker never did.
+        // The same shared deadline applies to all fallback effects.
+        for control in self.records.values() {
+            if Instant::now() >= abort_deadline { break; }
+            let (Some(session), Some(turn)) = (self.session.upgrade(), self.turn.upgrade()) else { continue; };
+            let claim = {
+                let mut state = control.lock().unwrap_or_else(|error| error.into_inner());
+                if !state.admitted || state.terminal_claimed
+                    || (state.start_effects_started && !state.start_effects_finished) {
+                    None
+                } else if let Some((start, instant)) = state.admitted_start.clone() {
+                    let start_needed = !state.start_effects_started;
+                    state.start_effects_started = true;
+                    state.terminal_claimed = true;
+                    state.completion_preparation_started = true;
+                    Some((start, instant, state.disposition.take().unwrap_or(Terminal::Cancelled), start_needed))
+                } else { None }
+            };
+            if let Some((start, instant, outcome, start_needed)) = claim {
+                let work = async {
+                    if start_needed {
+                        if let EventMsg::ItemStarted(started) = &start.msg {
+                            turn.turn_timing_state.record_item_started(started.item.id(), started.started_at_ms).await;
+                        }
+                        let persisted = session.send_pica_owned_event(&turn, start.clone(), true).await;
+                        let mut state = control.lock().unwrap_or_else(|error| error.into_inner());
+                        state.start_effects_finished = true;
+                        state.start_persisted = Some(persisted);
+                    }
+                    complete_terminal(&session, &turn, start, instant, outcome, false, control.clone()).await
+                };
+                let outcome = timeout_at(abort_deadline, work).await.unwrap_or(PicaEventSettlement::Unavailable);
+                let mut state = control.lock().unwrap_or_else(|error| error.into_inner());
+                state.fallback_outcome = Some(outcome);
+            }
+        }
+        let mut results = self.results.clone();
+        for result in &mut results {
+            let key = CallKey { turn: result.turn.clone(), call: result.call.clone(), generation: result.generation };
+            if let Some(control) = self.records.get(&key) { result.stages = stages(control); }
+        }
+        results.extend(self.active.keys().map(|key| PicaEventResult {
+            turn: key.turn.clone(), call: key.call.clone(), generation: key.generation,
+            outcome: PicaEventSettlement::JoinUnobserved,
+            stages: self.records.get(key).map(|control| stages(control)).unwrap_or_default(),
+        }));
+        results
+    }
+
+}
+
+struct DrainSupervisor {
+    handle: Option<JoinHandle<()>>,
+    joined_ok: Option<bool>,
+}
+
+/// Shared lifetime owner for the exact task; drain is supervised independently of its callers.
+pub(crate) struct PicaDynamicEventOwner {
+    registry: tokio::sync::Mutex<PicaDynamicEventRegistry>,
+    next_generation: AtomicU64,
+    drain: Mutex<Option<(watch::Receiver<Option<Arc<Vec<PicaEventResult>>>>, Arc<tokio::sync::Mutex<DrainSupervisor>>)>>,
+}
+
+impl PicaDynamicEventOwner {
+    pub(crate) fn new(session: &Arc<Session>, turn: &Arc<TurnContext>) -> Arc<Self> {
+        Arc::new(Self { registry: tokio::sync::Mutex::new(PicaDynamicEventRegistry::new(session, turn)), next_generation: AtomicU64::new(1), drain: Mutex::new(None) })
+    }
+
+    /// Allocate a non-reused generation for this turn owner.
+    pub(crate) fn next_generation(&self) -> Option<u64> {
+        self.next_generation.fetch_update(Ordering::Relaxed, Ordering::Relaxed, |value| value.checked_add(1)).ok()
+    }
+
+    /// Reserve for the bound turn; this does not admit a tool call.
+    pub(crate) async fn reserve(&self, turn: &TurnContext, event: Event, generation: u64) -> Option<PicaDynamicEventTicket> {
+        if self.drain.lock().ok()?.is_some() { return None; }
+        self.registry.lock().await.reserve(turn, event, generation)
+    }
+
+    /// Share a retained drain result among normal finish and abort callers.
+    pub(crate) async fn drain(self: &Arc<Self>) -> Option<Arc<Vec<PicaEventResult>>> {
+        let (mut receiver, handle) = {
+            let mut state = self.drain.lock().ok()?;
+            if let Some((receiver, handle)) = state.as_ref() {
+                (receiver.clone(), handle.clone())
+            } else {
+                let (sender, receiver) = watch::channel(None);
+                let owner = self.clone();
+                let handle = tokio::spawn(async move {
+                    let results = owner.registry.lock().await.close_and_join().await;
+                    let _ = sender.send(Some(Arc::new(results)));
+                });
+                let handle = Arc::new(tokio::sync::Mutex::new(DrainSupervisor { handle: Some(handle), joined_ok: None }));
+                *state = Some((receiver.clone(), handle.clone()));
+                (receiver, handle)
+            }
+        };
+        let result = timeout(Duration::from_secs(65), async {
+            loop {
+                if let Some(results) = receiver.borrow().clone() { return Some(results); }
+                if receiver.changed().await.is_err() { return None; }
+            }
+        }).await;
+        let result = result.ok().flatten();
+        // Poll the retained supervisor by reference: cancellation of this observer
+        // cannot detach its handle. Other observers share the recorded result.
+        let Ok(mut slot) = timeout(Duration::from_secs(2), handle.lock()).await else { return None; };
+        if slot.joined_ok.is_none() {
+            if let Some(task) = slot.handle.as_mut() {
+                let Ok(joined) = timeout(Duration::from_secs(2), task).await else { return None; };
+                slot.joined_ok = Some(joined.is_ok());
+                slot.handle = None;
+            } else { return None; }
+        }
+        if slot.joined_ok != Some(true) { return None; }
+        result
+    }
+}
+
+impl PicaDynamicEventTicket {
+    /// Invoke inside the existing lease handoff; enqueue must be synchronous and nonblocking.
+    pub(crate) fn admit(&mut self, enqueue: impl FnOnce(&Event) -> bool) -> PicaEventAdmission {
+        let Ok(mut control) = self.control.lock() else { return PicaEventAdmission::NotAdmitted; };
+        if control.closed || control.admitted || control.admission.is_none() { return PicaEventAdmission::NotAdmitted; }
+        let EventMsg::ItemStarted(start) = &mut self.event.msg else { return PicaEventAdmission::NotAdmitted; };
+        start.started_at_ms = now_unix_timestamp_ms();
+        let admitted_at = Instant::now();
+        if !enqueue(&self.event) {
+            control.closed = true;
+            if let Some(sender) = control.admission.take() { let _ = sender.send(None); }
+            return PicaEventAdmission::NotAdmitted;
+        }
+        control.admitted = true;
+        control.admitted_start = Some((self.event.clone(), admitted_at));
+        if control.admission.take().is_some_and(|sender| sender.send(Some((self.event.clone(), admitted_at))).is_ok()) {
+            PicaEventAdmission::Committed
+        } else {
+            PicaEventAdmission::CommittedUnavailable
+        }
+    }
+
+    /// Bind one terminal result to this exact ticket; subsequent attempts fail.
+    pub(crate) fn respond(&self, response: DynamicToolResponse) -> bool {
+        if serde_json::to_vec(&response).map_or(true, |bytes| bytes.len() > MAX_RESPONSE_BYTES) { return false; }
+        let Ok(mut control) = self.control.lock() else { return false; };
+        if !control.admitted || control.closed || control.terminal_claimed { return false; }
+        control.closed = true;
+        control.disposition = Some(Terminal::Response(response.clone()));
+        if let Some(sender) = control.terminal.take() { let _ = sender.send(Terminal::Response(response)); }
+        true
+    }
+
+    pub(crate) fn matches(&self, turn: &str, call: &str, generation: u64) -> bool {
+        self.key.turn == turn && self.key.call == call && self.key.generation == generation
+    }
+}
+
+impl Drop for PicaDynamicEventTicket {
+    fn drop(&mut self) { cancel(&self.control); }
+}
+
+fn cancel(control: &Mutex<Control>) {
+    let mut control = control.lock().unwrap_or_else(|error| error.into_inner());
+    if control.closed { return; }
+    control.closed = true;
+    if control.admitted && control.disposition.is_none() { control.disposition = Some(Terminal::Cancelled); }
+    if let Some(sender) = control.admission.take() { let _ = sender.send(None); }
+    if let Some(sender) = control.terminal.take() { let _ = sender.send(Terminal::Cancelled); }
+}
+
+fn stages(control: &Mutex<Control>) -> PicaEventStages {
+    let state = control.lock().unwrap_or_else(|error| error.into_inner());
+    PicaEventStages {
+        start_effects_started: state.start_effects_started,
+        start_effects_finished: state.start_effects_finished,
+        start_persisted: state.start_persisted,
+        completion_preparation_started: state.completion_preparation_started,
+        completion_preparation_finished: state.completion_preparation_finished,
+        terminal_enqueue_attempted: state.terminal_enqueue_attempted,
+        terminal_enqueue_succeeded: state.terminal_enqueue_succeeded,
+        terminal_effects_started: state.terminal_effects_started,
+        terminal_effects_finished: state.terminal_effects_finished,
+        terminal_persisted: state.terminal_persisted,
+        fallback_outcome: state.fallback_outcome,
+    }
+}
+
+async fn run_worker(
+    session: Weak<Session>, turn: Weak<TurnContext>, control: Arc<Mutex<Control>>,
+    mut admission: oneshot::Receiver<Option<(Event, Instant)>>, terminal: oneshot::Receiver<Terminal>,
+) -> PicaEventSettlement {
+    let admitted = match timeout(WAIT_LIMIT, &mut admission).await {
+        Ok(result) => result.ok().flatten(),
+        Err(_) => {
+            // Keep the receiver alive until the synchronous admission lock decides.
+            let admitted = {
+                let mut state = control.lock().unwrap_or_else(|error| error.into_inner());
+                if !state.admitted { state.closed = true; state.admission.take(); }
+                state.admitted
+            };
+            if admitted { admission.await.ok().flatten() } else { None }
+        }
+    };
+    let Some((start, admitted_at)) = admitted else { return PicaEventSettlement::NotAdmitted; };
+    let (Some(session), Some(turn)) = (session.upgrade(), turn.upgrade()) else { return PicaEventSettlement::Unavailable; };
+    let EventMsg::ItemStarted(started) = &start.msg else { return PicaEventSettlement::Unavailable; };
+    {
+        let mut state = control.lock().unwrap_or_else(|error| error.into_inner());
+        if state.terminal_claimed { return PicaEventSettlement::Unavailable; }
+        state.start_effects_started = true;
+    }
+    turn.turn_timing_state.record_item_started(started.item.id(), started.started_at_ms).await;
+    let start_persisted = matches!(timeout(PERSIST_LIMIT, session.send_pica_owned_event(&turn, start.clone(), true)).await, Ok(true));
+    {
+        let mut state = control.lock().unwrap_or_else(|error| error.into_inner());
+        state.start_effects_finished = true;
+        state.start_persisted = Some(start_persisted);
+    }
+    // The active invocation ends through its actual response or cancellation,
+    // not an unrelated thirty-second terminal wait deadline.
+    let notified = terminal.await.ok();
+    let (outcome, terminal_available) = {
+        let mut state = control.lock().unwrap_or_else(|error| error.into_inner());
+        if state.terminal_claimed { return PicaEventSettlement::Unavailable; }
+        state.terminal_claimed = true;
+        state.completion_preparation_started = true;
+        match state.disposition.take().or(notified) {
+            Some(outcome) => (outcome, true),
+            None => (Terminal::Cancelled, false),
+        }
+    };
+    complete_terminal(&session, &turn, start, admitted_at, outcome, start_persisted && terminal_available, control).await
+}
+
+async fn complete_terminal(
+    session: &Session, turn: &TurnContext, start: Event, admitted_at: Instant,
+    outcome: Terminal, previous_effects_observed: bool, control: Arc<Mutex<Control>>,
+) -> PicaEventSettlement {
+    let EventMsg::ItemStarted(started) = &start.msg else { return PicaEventSettlement::Unavailable; };
+    let TurnItem::DynamicToolCall(mut item) = started.item.clone() else { return PicaEventSettlement::Unavailable; };
+    let terminal_result = match &outcome {
+        Terminal::Response(response) if response.success => PicaEventSettlement::Completed,
+        Terminal::Response(_) => PicaEventSettlement::Failed,
+        Terminal::Cancelled => PicaEventSettlement::Cancelled,
+    };
+    match outcome {
+        Terminal::Response(response) => {
+            item.status = if response.success { DynamicToolCallStatus::Completed } else { DynamicToolCallStatus::Failed };
+            item.content_items = Some(response.content_items);
+            item.success = Some(response.success);
+            item.error = None;
+        }
+        Terminal::Cancelled => {
+            item.status = DynamicToolCallStatus::Failed;
+            item.content_items = Some(Vec::new());
+            item.success = Some(false);
+            item.error = Some("dynamic tool call was cancelled before receiving a response".to_string());
+        }
+    }
+    item.duration = Some(admitted_at.elapsed());
+    let completion = session.prepare_turn_item_completed(&turn, TurnItem::DynamicToolCall(item)).await;
+    let completed = Event { id: start.id.clone(), msg: completion };
+    {
+        let mut state = control.lock().unwrap_or_else(|error| error.into_inner());
+        state.completion_preparation_finished = true;
+    }
+    {
+        let mut state = control.lock().unwrap_or_else(|error| error.into_inner());
+        state.terminal_enqueue_attempted = true;
+    }
+    let delivered = session.get_tx_event().try_send(completed.clone()).is_ok();
+    {
+        let mut state = control.lock().unwrap_or_else(|error| error.into_inner());
+        state.terminal_enqueue_succeeded = delivered;
+        state.terminal_effects_started = true;
+    }
+    let persisted = matches!(timeout(PERSIST_LIMIT, session.send_pica_owned_event(&turn, completed, true)).await, Ok(true));
+    {
+        let mut state = control.lock().unwrap_or_else(|error| error.into_inner());
+        state.terminal_effects_finished = true;
+        state.terminal_persisted = Some(persisted);
+        state.admitted_start = None;
+    }
+    if previous_effects_observed && delivered && persisted { terminal_result } else { PicaEventSettlement::Unavailable }
+}
