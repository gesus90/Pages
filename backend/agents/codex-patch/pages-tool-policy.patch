+/// Private authority for one allocated Pica turn, revoked monotonically.
+pub(crate) struct PicaTurnLease {
+    state: std::sync::Mutex<PicaLeaseState>,
+    pub(crate) cancellation: tokio_util::sync::CancellationToken,
+}
+
+#[derive(Clone, Copy, PartialEq, Eq)]
+enum PicaLeaseState { Pending, Preparing, Admitted, Revoked }
+
+impl PicaTurnLease {
+    pub(crate) fn new() -> Self {
+        Self { state: std::sync::Mutex::new(PicaLeaseState::Pending), cancellation: tokio_util::sync::CancellationToken::new() }
+    }
+    pub(crate) fn admitted(&self) -> bool {
+        self.state.lock().is_ok_and(|state| *state == PicaLeaseState::Admitted)
+    }
+    /// Orders a synchronous handoff against revocation; no I/O is awaited here.
+    pub(crate) fn handoff<T>(&self, action: impl FnOnce() -> T) -> Option<T> {
+        let state = self.state.lock().ok()?;
+        if *state != PicaLeaseState::Admitted || self.cancellation.is_cancelled() { return None; }
+        Some(action())
+    }
+    pub(crate) fn permit(&self) -> Option<tokio_util::sync::CancellationToken> {
+        self.handoff(|| self.cancellation.child_token())
+    }
