+        if !lease.begin() { return Err(refused().into()); }
+    }
+    let request = codex_protocol::protocol::PicaRegistryReadyRequest {
+        request_id: format!("pica-ready-{}", turn.sub_id),
+        thread_id: sess.thread_id.to_string(),
+        turn_id: turn.sub_id.clone(),
+        operation_id: operation.operation_id.clone(),
+        nonce: operation.nonce.clone(),
+        sequence: operation.sequence,
+        context: policy.context.clone(),
+        catalog: policy.catalog.clone(),
+    };
+    let (sender, receiver) = tokio::sync::oneshot::channel();
+    let _ready_guard = {
+        let mut active = sess.active_turn.lock().await;
+        let active = active.as_mut().ok_or_else(refused)?;
+        let task = active.task.as_ref().ok_or_else(refused)?;
+        if !pica_same_turn(task.turn_context.as_ref(), turn) || task.cancellation_token.is_cancelled() {
+            return Err(refused().into());
+        }
+        let mut state = active.turn_state.lock().await;
+        state.insert_pending_pica_ready(request.request_id.clone(), sender).ok_or_else(refused)?
+    };
