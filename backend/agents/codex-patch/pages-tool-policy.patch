+/// A single, shareable terminal result for a private revoke request.
+pub struct PicaRevocationSettlement {
+    pub request: codex_protocol::protocol::PicaRegistryReadyRequest,
+    state: std::sync::Mutex<(Option<codex_protocol::protocol::PicaRevocationOutcome>, Vec<futures::channel::oneshot::Sender<codex_protocol::protocol::PicaRevocationOutcome>>)>,
+}
+
+impl std::fmt::Debug for PicaRevocationSettlement {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result { f.write_str("PicaRevocationSettlement([redacted])") }
+}
+
+impl PicaRevocationSettlement {
+    pub fn new(request: codex_protocol::protocol::PicaRegistryReadyRequest) -> Self {
+        Self { request, state: std::sync::Mutex::new((None, Vec::new())) }
+    }
+    pub fn subscribe(&self) -> futures::channel::oneshot::Receiver<codex_protocol::protocol::PicaRevocationOutcome> {
+        let (sender, receiver) = futures::channel::oneshot::channel();
+        let mut state = self.state.lock().unwrap_or_else(std::sync::PoisonError::into_inner);
+        if let Some(outcome) = state.0 { let _ = sender.send(outcome); }
+        else if state.1.len() >= 32 { let _ = sender.send(codex_protocol::protocol::PicaRevocationOutcome::Unavailable); }
+        else { state.1.push(sender); }
+        receiver
+    }
+    pub fn acknowledged(&self) -> bool {
+        self.state.lock().is_ok_and(|state| state.0 == Some(codex_protocol::protocol::PicaRevocationOutcome::Acknowledged))
+    }
+    pub fn finish(&self, outcome: codex_protocol::protocol::PicaRevocationOutcome) {
+        let mut state = self.state.lock().unwrap_or_else(std::sync::PoisonError::into_inner);
+        if state.0.is_some() { return; }
+        state.0 = Some(outcome);
+        let waiters = std::mem::take(&mut state.1);
+        drop(state);
+        for waiter in waiters { let _ = waiter.send(outcome); }
+    }
+}
