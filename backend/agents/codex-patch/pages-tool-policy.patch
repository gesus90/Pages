+pub(crate) fn notify_pica_revoked(sess: &Session, turn: &TurnContext) -> Option<Arc<codex_extension_api::PicaRevocationSettlement>> {
+    let operation = turn.extension_data.get::<codex_protocol::protocol::PicaOperation>()?;
+    let policy = sess.services.thread_extension_data.get::<codex_extension_api::PicaPolicyContext>()?;
+    let request = codex_protocol::protocol::PicaRegistryReadyRequest {
+        request_id: format!("pica-revoke-{}", turn.sub_id),
+        thread_id: sess.thread_id.to_string(),
+        turn_id: turn.sub_id.clone(),
+        operation_id: operation.operation_id.clone(),
+        nonce: operation.nonce.clone(),
+        sequence: operation.sequence,
+        context: operation.context.clone(),
+        catalog: operation.catalog.clone(),
+    };
+    let settlement = {
+        let Ok(mut settlements) = policy.settlements.lock() else { policy.owner.revoke(); return None; };
+        if let Some(existing) = settlements.get(&request.request_id) { return Some(Arc::clone(existing)); }
+        if settlements.len() >= 4096 { policy.owner.revoke(); return None; }
+        let settlement = Arc::new(codex_extension_api::PicaRevocationSettlement::new(request.clone()));
+        settlements.insert(request.request_id.clone(), Arc::clone(&settlement));
+        settlement
+    };
