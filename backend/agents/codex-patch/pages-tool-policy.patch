+pub(crate) async fn ensure_pica_turn(sess: &Session, turn: &TurnContext) -> CodexResult<()> {
+    if std::env::var_os("PAGES_PICA_CODEX").as_deref() != Some(std::ffi::OsStr::new("1")) { return Ok(()); }
+    let refused = || CodexErrorDetails::InvalidRequest("Pica admission refused".to_string());
+    let lease = turn.extension_data.get::<super::turn_context::PicaTurnLease>().ok_or_else(refused)?;
+    let active = sess.active_turn.lock().await;
+    let task = active.as_ref().and_then(|active| active.task.as_ref()).ok_or_else(refused)?;
+    if !pica_same_turn(task.turn_context.as_ref(), turn) || task.cancellation_token.is_cancelled() || !lease.admitted() {
+        return Err(refused().into());
+    }
+    Ok(())
