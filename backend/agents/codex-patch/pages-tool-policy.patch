index 0000000..d2b3ff2
--- /dev/null
+++ b/codex-rs/core/src/session/pica_retirement.rs
@@ -0,0 +1,316 @@
+//! Session-owned, bounded consumers for Pica turn event retirement.
+use std::collections::{HashMap, VecDeque};
+use std::sync::{Arc, Mutex, Weak};
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::time::Duration;
+use std::future::Future;
+
+use futures::FutureExt;
+use tokio::task::JoinHandle;
+use tokio::time::{Instant, sleep};
+use tokio_util::sync::CancellationToken;
+use tracing::warn;
+use codex_protocol::turn_input::{TurnInputMode, TurnInputRequest};
+
+use super::pica_dynamic_events::{PicaDynamicEventOwner, PicaEventResult, PicaEventSettlement};
+use super::turn_context::TurnContext;
+
+const MAX_RETIREMENTS: usize = 64;
+const SHUTDOWN_LIMIT: Duration = Duration::from_secs(70);
+
+struct Retirement {
+    close: CancellationToken,
+    handle: JoinHandle<Option<Arc<Vec<PicaEventResult>>>>,
+}
+
+enum RetirementOutcome {
+    Finished(Arc<Vec<PicaEventResult>>),
+    Unavailable,
+    JoinUnobserved,
+    JoinError { cancelled: bool, panic: bool },
+}
+
+pub(crate) struct PicaAttachmentFence<'a> {
+    _guard: std::sync::MutexGuard<'a, HashMap<String, Startup>>,
+}
+
+struct Startup {
+    cancellation: CancellationToken,
+    handle: JoinHandle<PicaStartupStatus>,
+}
+
+#[derive(Clone, Copy, Debug)]
+pub(crate) enum PicaStartupStatus { Started, Rejected, Failed }
+
+/// Whole input stays owned by the root when startup admission is refused.
+pub(crate) struct PicaStartupPayload {
+    pub(crate) request: TurnInputRequest,
+    pub(crate) mode: TurnInputMode,
+    pub(crate) submission_id: String,
+}
+
+#[derive(Clone, Copy, Debug)]
+pub(crate) enum PicaStartupRefusal { ShuttingDown, Duplicate, Capacity, Unavailable }
+
+pub(crate) struct PicaRefusedStartup {
+    pub(crate) payload: PicaStartupPayload,
+    pub(crate) reason: PicaStartupRefusal,
+}
+
+/// Retains reaper handles independently of task and abort observers.
+#[derive(Default)]
+pub(crate) struct PicaRetirements {
+    entries: Mutex<HashMap<String, Retirement>>,
+    completed: Mutex<VecDeque<(String, RetirementOutcome)>>,
+    reservations: Mutex<HashMap<String, Arc<()>>>,
+    shutting_down: AtomicBool,
+    startups: Mutex<HashMap<String, Startup>>,
+    startup_results: Mutex<VecDeque<(String, Option<PicaStartupStatus>)>>,
+    refused_startups: Mutex<Vec<Arc<PicaRefusedStartup>>>,
+}
+
+/// A capacity claim that removes only its own uncommitted reservation.
+pub(crate) struct PicaRetirementReservation {
+    manager: Weak<PicaRetirements>,
+    id: String,
+    identity: Arc<()>,
+    committed: bool,
+}
+
+impl Drop for PicaRetirementReservation {
+    fn drop(&mut self) {
+        if self.committed { return; }
+        if let Some(manager) = self.manager.upgrade() {
+            let mut reservations = manager.reservations.lock().unwrap_or_else(|error| error.into_inner());
+            if reservations.get(&self.id).is_some_and(|value| Arc::ptr_eq(value, &self.identity)) {
+                reservations.remove(&self.id);
+            }
+        }
+    }
+}
+
+impl PicaRetirements {
+    /// Reserve capacity before changing an existing turn or consuming input.
+    pub(crate) fn reserve(self: &Arc<Self>, id: String) -> Option<PicaRetirementReservation> {
+        let entries = self.entries.lock().ok()?;
+        let mut reservations = self.reservations.lock().ok()?;
+        if self.shutting_down.load(Ordering::Acquire) || entries.len() + reservations.len() >= MAX_RETIREMENTS
+            || entries.contains_key(&id) || reservations.contains_key(&id) { return None; }
+        let identity = Arc::new(());
+        reservations.insert(id.clone(), identity.clone());
+        Some(PicaRetirementReservation { manager: Arc::downgrade(self), id, identity, committed: false })
+    }
+
+    /// Consume a previously reserved slot before the task is made visible.
+    pub(crate) fn register(self: &Arc<Self>, turn: Arc<TurnContext>, owner: Arc<PicaDynamicEventOwner>, lease: CancellationToken, mut reservation: PicaRetirementReservation) -> bool {
+        if reservation.id != turn.sub_id || !reservation.manager.upgrade().is_some_and(|manager| Arc::ptr_eq(&manager, self)) { return false; }
+        let Ok(mut entries) = self.entries.lock() else { return false; };
+        let Ok(mut reservations) = self.reservations.lock() else { return false; };
+        if self.shutting_down.load(Ordering::Acquire) || entries.contains_key(&reservation.id)
+            || !reservations.get(&reservation.id).is_some_and(|value| Arc::ptr_eq(value, &reservation.identity)) { return false; }
+        let id = reservation.id.clone();
+        let close = CancellationToken::new();
+        let signal = close.clone();
+        let handle = tokio::spawn(async move {
+            tokio::select! { _ = signal.cancelled() => {}, _ = lease.cancelled() => {} }
+            let _turn = turn;
+            owner.drain().await
+        });
+        entries.insert(id.clone(), Retirement { close, handle });
+        reservations.remove(&id);
+        reservation.committed = true;
+        true
+    }
+
+    /// Atomically reserve and install the gated startup before consuming input.
+    pub(crate) fn admit_startup<A, F, Make>(self: &Arc<Self>, id: String, cancellation: CancellationToken, payload: A, make: Make) -> Result<(), (A, PicaStartupRefusal)>
+    where
+        A: Send + 'static,
+        F: Future<Output = PicaStartupStatus> + Send + 'static,
+        Make: FnOnce(A, PicaRetirementReservation) -> F + Send + 'static,
+    {
+        let runtime = match tokio::runtime::Handle::try_current() {
+            Ok(runtime) => runtime,
+            Err(_) => return Err((payload, PicaStartupRefusal::Unavailable)),
+        };
+        let Ok(mut startups) = self.startups.lock() else { return Err((payload, PicaStartupRefusal::Unavailable)); };
+        let Ok(entries) = self.entries.lock() else { return Err((payload, PicaStartupRefusal::Unavailable)); };
+        let Ok(mut reservations) = self.reservations.lock() else { return Err((payload, PicaStartupRefusal::Unavailable)); };
+        if self.shutting_down.load(Ordering::Acquire) { return Err((payload, PicaStartupRefusal::ShuttingDown)); }
+        if startups.contains_key(&id) || entries.contains_key(&id) || reservations.contains_key(&id) {
+            return Err((payload, PicaStartupRefusal::Duplicate));
+        }
+        if entries.len() + reservations.len() >= MAX_RETIREMENTS || startups.len() >= MAX_RETIREMENTS {
+            return Err((payload, PicaStartupRefusal::Capacity));
+        }
+        let identity = Arc::new(());
+        reservations.insert(id.clone(), Arc::clone(&identity));
+        let reservation = PicaRetirementReservation { manager: Arc::downgrade(self), id: id.clone(), identity, committed: false };
+        let (ready, wait) = tokio::sync::oneshot::channel::<(A, PicaRetirementReservation, Make)>();
+        let handle = runtime.spawn(async move {
+            match wait.await {
+                Ok((payload, reservation, make)) => make(payload, reservation).await,
+                Err(_) => PicaStartupStatus::Failed,
+            }
+        });
+        startups.insert(id, Startup { cancellation, handle });
+        drop(reservations);
+        drop(entries);
+        drop(startups);
+        match ready.send((payload, reservation, make)) {
+            Ok(()) => Ok(()),
+            Err((payload, reservation, _make)) => {
+                drop(reservation);
+                Err((payload, PicaStartupRefusal::Unavailable))
+            }
+        }
+    }
+
+    /// Keep refused input owned by this Session rather than dropping it at the RPC boundary.
+    pub(crate) fn retain_refused_startup(&self, payload: PicaStartupPayload, reason: PicaStartupRefusal) -> Arc<PicaRefusedStartup> {
+        let refused = Arc::new(PicaRefusedStartup { payload, reason });
+        self.refused_startups.lock().unwrap_or_else(|error| error.into_inner()).push(Arc::clone(&refused));
+        refused
+    }
+
+    /// Query the exact retained refusal by identity, including its untouched payload.
+    pub(crate) fn refused_startup(&self, target: &Arc<PicaRefusedStartup>) -> Option<Arc<PicaRefusedStartup>> {
+        self.refused_startups.lock().unwrap_or_else(|error| error.into_inner()).iter().find(|entry| Arc::ptr_eq(entry, target)).cloned()
+    }
+
+    /// Reject future grants before shutdown begins operating on tasks.
+    pub(crate) fn close_start_admission(&self) {
+        if let Ok(startups) = self.startups.lock() {
+            self.shutting_down.store(true, Ordering::Release);
+            for startup in startups.values() { startup.cancellation.cancel(); }
+        } else {
+            self.shutting_down.store(true, Ordering::Release);
+        }
+    }
+
+    /// Serialize final synchronous task attachment with shutdown admission.
+    pub(crate) fn attachment_fence(&self) -> Option<PicaAttachmentFence<'_>> {
+        let guard = self.startups.lock().ok()?;
+        if self.shutting_down.load(Ordering::Acquire) { return None; }
+        Some(PicaAttachmentFence { _guard: guard })
+    }
+
+    pub(crate) fn is_closing(&self) -> bool {
+        self.shutting_down.load(Ordering::Acquire)
+    }
+
+    pub(crate) fn request_close(&self, turn_id: &str) {
+        if let Ok(entries) = self.entries.lock() {
+            if let Some(entry) = entries.get(turn_id) { entry.close.cancel(); }
+        }
+    }
+
+    pub(crate) fn has_entries(&self) -> bool {
+        self.entries.lock().map_or(true, |entries| !entries.is_empty())
+            || self.startups.lock().map_or(true, |startups| !startups.is_empty())
+    }
+
+    fn has_reservations(&self) -> bool {
+        self.reservations.lock().map_or(true, |reservations| !reservations.is_empty())
+    }
+
+    /// Poll borrowed handles; a pending join is never removed.
+    pub(crate) fn reap_ready(&self) {
+        if let Ok(mut startups) = self.startups.lock() {
+            let ids: Vec<_> = startups.iter().filter_map(|(id, startup)| startup.handle.is_finished().then_some(id.clone())).collect();
+            for id in ids {
+                let joined = startups.get_mut(&id).and_then(|startup| (&mut startup.handle).now_or_never());
+                if let Some(joined) = joined {
+                    let status = match joined {
+                        Ok(status) => Some(status),
+                        Err(error) => {
+                            warn!(turn = %id, cancelled = error.is_cancelled(), panic = error.is_panic(), "Pica startup task failed");
+                            None
+                        }
+                    };
+                    let mut results = self.startup_results.lock().unwrap_or_else(|error| error.into_inner());
+                    if results.len() == MAX_RETIREMENTS { results.pop_front(); }
+                    results.push_back((id.clone(), status));
+                    startups.remove(&id);
+                }
+            }
+        }
+        let Ok(mut entries) = self.entries.lock() else { return; };
+        let ids: Vec<_> = entries.iter().filter_map(|(id, entry)| entry.handle.is_finished().then_some(id.clone())).collect();
+        for id in ids {
+            let Ok(mut completed) = self.completed.lock() else { return; };
+            let joined = entries.get_mut(&id).and_then(|entry| (&mut entry.handle).now_or_never());
+            let Some(joined) = joined else { continue; };
+            let outcome = match joined {
+                Ok(Some(results)) => RetirementOutcome::Finished(results),
+                Ok(None) => RetirementOutcome::Unavailable,
+                Err(error) => RetirementOutcome::JoinError { cancelled: error.is_cancelled(), panic: error.is_panic() },
+            };
+            // Cache the observed result before removing its ready handle.
+            match &outcome {
+                RetirementOutcome::Finished(results) => for result in results.iter() {
+                    if matches!(result.outcome, PicaEventSettlement::Unavailable | PicaEventSettlement::JoinUnobserved) {
+                        warn!(turn = %result.turn, call = %result.call, generation = result.generation, outcome = ?result.outcome, stages = ?result.stages, "Pica retirement unavailable");
+                    }
+                },
+                RetirementOutcome::Unavailable => warn!(turn = %id, "Pica retirement outcome unavailable"),
+                RetirementOutcome::JoinUnobserved => warn!(turn = %id, "Pica retirement join unobserved"),
+                RetirementOutcome::JoinError { cancelled, panic } => warn!(turn = %id, cancelled, panic, "Pica retirement reaper failed"),
+            }
+            if completed.len() == MAX_RETIREMENTS { completed.pop_front(); }
+            completed.push_back((id.clone(), outcome));
+            entries.remove(&id);
+        }
+    }
+
+    /// Signal every remaining owner and observe ready joins under one shared deadline.
+    pub(crate) async fn shutdown(&self) {
+        self.close_start_admission();
+        if let Ok(entries) = self.entries.lock() {
+            for entry in entries.values() { entry.close.cancel(); }
+        }
+        let deadline = Instant::now() + SHUTDOWN_LIMIT;
+        loop {
+            self.reap_ready();
+            if !self.has_entries() && !self.has_reservations() { return; }
+            if Instant::now() >= deadline {
+                if let Ok(startups) = self.startups.lock() {
+                    for id in startups.keys() { warn!(turn = %id, "Pica startup join unobserved at shutdown"); }
+                }
+                if let Ok(reservations) = self.reservations.lock() {
+                    for id in reservations.keys() {
+                        warn!(turn = %id, "Pica startup reservation unresolved at shutdown");
+                    }
+                }
+                if let (Ok(entries), Ok(mut completed)) = (self.entries.lock(), self.completed.lock()) {
+                    for id in entries.keys() {
+                        warn!(turn = %id, "Pica retirement deadline elapsed; join unobserved");
+                        if completed.len() == MAX_RETIREMENTS { completed.pop_front(); }
+                        completed.push_back((id.clone(), RetirementOutcome::JoinUnobserved));
+                    }
+                }
+                return;
+            }
+            sleep(Duration::from_millis(50)).await;
+        }
+    }
+}
+
+impl Drop for PicaRetirements {
+    fn drop(&mut self) {
+        if let Ok(startups) = self.startups.get_mut() {
+            for (id, startup) in startups.iter_mut() {
+                warn!(turn = %id, "Pica startup owner dropped before join was observed");
+                startup.cancellation.cancel();
+                startup.handle.abort();
+            }
+        }
+        if let Ok(entries) = self.entries.get_mut() {
+            for (turn_id, entry) in entries.iter_mut() {
+                warn!(turn = %turn_id, "Pica retirement owner dropped before join was observed");
+                entry.close.cancel();
+                entry.handle.abort();
+            }
+        }
+    }
+}
