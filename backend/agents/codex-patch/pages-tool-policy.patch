+/// Admit a request against the live task and return its revocation signal.
+pub(crate) async fn pica_request_permit(sess: &Session, turn: &TurnContext) -> CodexResult<Option<CancellationToken>> {
+    if std::env::var_os("PAGES_PICA_CODEX").as_deref() != Some(std::ffi::OsStr::new("1")) { return Ok(None); }
+    let refused = || CodexErrorDetails::InvalidRequest("Pica admission refused".to_string());
+    let lease = turn.extension_data.get::<super::turn_context::PicaTurnLease>().ok_or_else(refused)?;
+    let active = sess.active_turn.lock().await;
+    let task = active.as_ref().and_then(|active| active.task.as_ref()).ok_or_else(refused)?;
+    if !pica_same_turn(task.turn_context.as_ref(), turn) || task.cancellation_token.is_cancelled() {
+        return Err(refused().into());
+    }
+    Ok(Some(lease.permit().ok_or_else(refused)?))
