# Copy to `.env` for local use; `.env` files are ignored by git.

# Optional: the Pages server address a build starts with. HTTPS only (plain
# HTTP is accepted in development builds). A person can change it in the
# settings. Leave it empty for a build that asks for the address.
EXPO_PUBLIC_PAGES_SERVER_URL=

# development (the default), preview or production. The profiles in eas.json set
# it; it selects the name, the identifiers and the URL scheme of the build.
APP_VARIANT=

# The id `eas init` prints. It links the project to the Expo account and is not
# a secret; EAS needs it before the first build.
EAS_PROJECT_ID=
