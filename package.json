{
  "name": "pages",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "build": "react-router build",
    "format": "prettier --write .",
    "check": "tsc --noEmit && prettier --check .",
    "clean": "node -e \"require('node:fs').rmSync('build', { recursive: true, force: true })\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:frontend": "vitest run --project frontend",
    "test:backend": "vitest run --project backend"
  },
  "dependencies": {
    "@duckdb/node-api": "^1.5.5-r.4",
    "@node-rs/argon2": "^2.2.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@react-router/node": "^7.18.3",
    "@react-router/serve": "^7.18.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.4.2",
    "isbot": "^5",
    "lucide-react": "^1.40.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.13",
    "react-router": "^7.18.3",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@react-router/dev": "^7.18.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitest/coverage-v8": "^5.0.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@11.23.0"
}
