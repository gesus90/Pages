{
  "name": "pages",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "start": "node server.mjs",
    "build": "react-router build",
    "format": "prettier --write .",
    "lint": "eslint . --max-warnings=0",
    "check": "react-router typegen && tsc --noEmit && prettier --check .",
    "clean": "node -e \"require('node:fs').rmSync('build', { recursive: true, force: true })\"",
    "db:transfer": "tsx scripts/migrate-sqlite-to-duckdb.ts",
    "test": "vitest run --coverage",
    "test:frontend": "cross-env VITEST_FRONTEND=true vitest run --coverage",
    "test:backend": "cross-env VITEST_BACKEND=true vitest run --coverage"
  },
  "dependencies": {
    "@duckdb/node-api": "1.5.5-r.5",
    "@fontsource-variable/inter": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@react-router/node": "^8.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.4.2",
    "isbot": "^5.2.2",
    "lru-cache": "^11.5.3",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "react-markdown": "^10.1.0",
    "react-router": "^8.4.0",
    "remark-gfm": "^4.0.1",
    "smol-toml": "^1.9.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@react-router/dev": "^8.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.2",
    "better-sqlite3": "^13.0.3",
    "cross-env": "^10.1.0",
    "eslint": "^10.11.0",
    "eslint-plugin-jsdoc": "^64.5.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^7.3.6",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=22.22.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@11.23.0"
}
