# Environment of deploy/backups/rotate-deploy-backups.sh; the deploy flow sources it.

# Holds one directory per deploy backup; only the newest deploy backup stays.
PAGES_DEPLOY_BACKUP_ROOT=/mnt/Data/PagesBackups
# The file system of /mnt/Data; `findmnt --output UUID --target /mnt/Data` shows it. Optional.
PAGES_DEPLOY_BACKUP_UUID=58770877-bfea-4425-bcff-975a7cf34efe
# The continuous PostgreSQL backup; the command refuses a root that overlaps it.
PAGES_POSTGRES_BACKUP_ROOT=/mnt/Data/PagesPostgres
# Where pg_restore checks the dumps of a backup.
PAGES_POSTGRES_PROGRAMS=/usr/lib/postgresql/18/bin
# The instance home; deploy-* folders directly in it are leftovers of a deploy.
PAGES_HOME=/home/pages/.pages
