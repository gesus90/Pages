[Unit]
Description=Pages GitHub and FCM integrations (%i)
After=network-online.target pages-postgres@%i.service pages-api@%i.service
Wants=pages-postgres@%i.service
PartOf=pages.target
StartLimitIntervalSec=0
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=all
WatchdogSec=60
TimeoutStartSec=180
User=pages
Group=pages
WorkingDirectory=/opt/pages
ExecStart=/usr/bin/env node --max-old-space-size=160 /opt/pages/pages-integrations.mjs --config /etc/pages/%i/config.toml
Restart=always
RestartSec=5
# Zielarchitektur rev12: pages-integrations 256 MB starting budget.
MemoryMax=256M
OOMScoreAdjust=-250
MemorySwapMax=0
TimeoutStopSec=35
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/pages/%i /etc/pages/%i
Environment=NODE_ENV=production
EnvironmentFile=-/etc/pages/%i/runtime.env

[Install]
WantedBy=pages.target
