# Copy to /etc/pages/postgres-backup.env, mode 0600. The password belongs in the file
# PGPASSFILE names, never here.

# The file system of /mnt/Data; `findmnt --output UUID --target /mnt/Data` shows it.
PAGES_POSTGRES_BACKUP_UUID=58770877-bfea-4425-bcff-975a7cf34efe
# Holds base/ and wal/ and the work directory of the restore check.
PAGES_POSTGRES_BACKUP_ROOT=/mnt/Data/PagesPostgres
PAGES_POSTGRES_BACKUP_KEEP=7
PAGES_POSTGRES_PROGRAMS=/usr/lib/postgresql/18/bin

# How pg_basebackup reaches the server: the role pages_backup of docs/PostgresMigration.md.
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=pages_backup
PGPASSFILE=/etc/pages/postgres-backup.pgpass
